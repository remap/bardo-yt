{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true
  },
  // The Worker only. static/ and dist/ are hand-written browser JS with no
  // types and no build step -- node --test covers them instead.
  "include": ["worker/**/*.ts", "worker-configuration.d.ts"]
}
